# Public Supabase client configuration (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used only by the authentication bootstrap route. Never expose it
# to the browser or commit it. It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret used to verify Telegram WebApp initData via HMAC.
# Never prefix this value with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to administer the building.
# Example: 123456789,987654321
TELEGRAM_ADMIN_IDS=
